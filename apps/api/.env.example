ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__HomePitDb=Host=supabase-db;Port=5432;Database=postgres;Username=supabase_admin;Password=replace-me
Database__ApplyMigrationsOnStartup=true
Jwt__Issuer=homepit
Jwt__Audience=homepit
Jwt__SigningKey=replace-with-at-least-32-random-characters
Jwt__AccessTokenMinutes=30
SuperAdmin__Email=superadmin@example.com
SuperAdmin__Password=replace-with-a-strong-password
SuperAdmin__DisplayName=SuperAdmin
EvolutionApi__BaseUrl=http://evolution-api:8080
EvolutionApi__InstanceName=homepit
EvolutionApi__ApiKey=replace-me
EvolutionApi__SendTextPathTemplate=/message/sendText/{instance}
ObjectStorage__Endpoint=http://homepit-minio:9000
ObjectStorage__AccessKey=homepitminiousuario
ObjectStorage__SecretKey=replace-me
ObjectStorage__BucketName=homepit-assets
ObjectStorage__UseSsl=false
ObjectStorage__CreateBucketOnStartup=true
Notifications__DailyDigestEnabled=true
Notifications__PollIntervalMinutes=5
Cors__AllowedOrigins__0=https://homepit.example.com
Integrations__Enabled=false
Integrations__TokenPepper=replace-with-at-least-32-random-characters
Mcp__Enabled=false
OAuth__Issuer=https://api.homepit.example.com
OAuth__WebConsentUrl=https://homepit.example.com/oauth/consent
OAuth__SigningKey=replace-with-a-base64-encoded-32-byte-key
OAuth__EncryptionKey=replace-with-a-different-base64-encoded-32-byte-key
OAuth__AccessTokenMinutes=15
OAuth__RefreshTokenDays=30
OAuth__InteractionMinutes=10
OAuth__TrustedProxies__0=172.18.0.1
