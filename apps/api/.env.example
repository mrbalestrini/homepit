ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__HomePitDb=Host=supabase-db;Port=5432;Database=postgres;Username=supabase_admin;Password=replace-me
Database__ApplyMigrationsOnStartup=true
Jwt__Issuer=homepit
Jwt__Audience=homepit
Jwt__SigningKey=replace-with-at-least-32-random-characters
Jwt__AccessTokenMinutes=30
EvolutionApi__BaseUrl=http://evolution-api:8080
EvolutionApi__InstanceName=homepit
EvolutionApi__ApiKey=replace-me
EvolutionApi__SendTextPathTemplate=/message/sendText/{instance}
Notifications__DailyDigestEnabled=true
Notifications__PollIntervalMinutes=5
Cors__AllowedOrigins__0=https://homepit.example.com
